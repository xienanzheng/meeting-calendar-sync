# Copy to .env (git-ignored). Names only - never commit values.
# MCS_EXTRACTOR=auto            # auto | claude-code | anthropic | foundry | fake
# MCS_MODEL=                    # default: sonnet (claude-code) / claude-sonnet-5-5 (anthropic, foundry)
# MCS_CALENDAR_SINK=ics         # ics | graph
# MCS_DEFAULT_MEETING_MINUTES=45
# MCS_PORT=8765
# ANTHROPIC_API_KEY=            # or macOS Keychain service: meeting-calendar-sync.anthropic-api-key
# ANTHROPIC_FOUNDRY_RESOURCE=
# ANTHROPIC_FOUNDRY_API_KEY=    # or macOS Keychain service: meeting-calendar-sync.foundry-api-key
# MCS_GRAPH_CLIENT_ID=
# MCS_GRAPH_TENANT_ID=
# MCS_AUTO_SYNC=                # approval sends: sync calendars after every approval-type change (default true)
# MCS_USE_KEYCHAIN=             # look up API keys in the macOS Keychain when not set in env (default true)
# MCS_EPHEMERAL=                # hosted demo: data resets when the container sleeps (default false)
# MCS_DATA_DIR=                 # runtime files: app.db and uploads/ (default: <repo>/data)
# MCS_EXTRACT_TIMEOUT=          # extraction timeout in seconds (default 240)
# MCS_CLAUDE_BIN=               # Claude Code CLI used by the claude-code extractor (default: claude)
