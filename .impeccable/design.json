      "description": "Navy fill for primary actions on light grounds.",
      "html": "<button class=\"ds-btn ds-btn-primary\">Verify meeting</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:40px;padding:0 16px;border-radius:6px;font-family:var(--font-heading);font-weight:700;font-size:14px;white-space:nowrap;cursor:pointer;border:1px solid transparent;transition:background-color 150ms ease-out,border-color 150ms ease-out;}.ds-btn:focus-visible{outline:2px solid var(--color-navy);outline-offset:2px;}.ds-btn-primary{background:var(--color-navy);color:#fff;}.ds-btn-primary:hover{background:var(--color-navy-2);}.ds-btn-primary:active{background:var(--color-navy-3);}"
    },
