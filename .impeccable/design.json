      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:40px;padding:0 16px;border-radius:6px;font-family:var(--font-heading);font-weight:700;font-size:14px;white-space:nowrap;cursor:pointer;border:1px solid transparent;transition:background-color 150ms ease-out,border-color 150ms ease-out;}.ds-btn:focus-visible{outline:2px solid var(--color-navy);outline-offset:2px;}.ds-bar-demo{background:var(--color-navy);padding:12px 16px;display:inline-block;}.ds-btn-beige{background:var(--color-beige);color:var(--color-navy);}.ds-btn-beige:hover{background:var(--color-beige-2);}.ds-btn-beige:active{background:var(--color-beige-3);}.ds-btn-beige:focus-visible{outline-color:var(--color-beige);}"
    },
