      "description": "Labelled text field with navy focus.",
      "html": "<label class=\"ds-field\"><span class=\"ds-field-label\">Room</span><input class=\"ds-input\" value=\"Ballroom C\"></label>",
      "css": ".ds-field{display:block;width:260px;}.ds-field-label{display:block;margin-bottom:4px;font-family:var(--font-sans);font-size:11px;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;color:var(--color-muted);}.ds-input{width:100%;border:1px solid var(--color-line);border-radius:6px;background:#fff;padding:6px 10px;font-family:var(--font-sans);font-size:14px;font-weight:500;color:var(--color-ink);caret-color:var(--color-navy);transition:border-color 150ms;}.ds-input:hover{border-color:var(--color-line-strong);}.ds-input:focus{border-color:var(--color-navy);}.ds-input:focus-visible{outline:2px solid var(--color-navy);outline-offset:1px;}"
    },
    {
      "name": "Status Chips",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Filter pills with Figtree counts; selected fills navy-2.",
      "html": "<div class=\"ds-chips\"><button class=\"ds-chip ds-chip-on\" aria-pressed=\"true\">All <b>8</b></button><button class=\"ds-chip\">Needs attention <b class=\"ds-red\">2</b></button><button class=\"ds-chip\">Warnings <b class=\"ds-amber\">3</b></button><button class=\"ds-chip\">Sent <b class=\"ds-zero\">0</b></button></div>",
      "css": ".ds-chips{display:flex;flex-wrap:wrap;gap:8px;}.ds-chip{display:inline-flex;align-items:center;gap:6px;height:32px;padding:0 12px;border-radius:9999px;border:1px solid var(--color-line);background:#fff;color:var(--color-ink);font-family:var(--font-sans);font-size:13px;font-weight:600;cursor:pointer;transition:background-color 150ms ease-out,border-color 150ms ease-out;}.ds-chip b{font-family:var(--font-heading);font-weight:700;font-variant-numeric:tabular-nums;}.ds-chip:hover{background:var(--color-cream);border-color:var(--color-line-strong);}.ds-chip:focus-visible{outline:2px solid var(--color-navy);outline-offset:2px;}.ds-chip-on,.ds-chip-on:hover{background:var(--color-navy-2);border-color:var(--color-navy-2);color:#fff;}.ds-chip-on b{color:var(--color-beige);}.ds-red{color:var(--color-red);}.ds-amber{color:var(--color-amber);}.ds-zero{color:var(--color-muted);}"
    },
    {
      "name": "Stamps",
      "kind": "custom",
      "refersTo": "stamp-verified",
      "description": "Meeting state stamps: tilted when earned, flat when untouched or cancelled.",
      "html": "<div class=\"ds-stamps\"><span class=\"ds-stamp ds-stamp-navy\">VERIFIED</span><span class=\"ds-stamp ds-stamp-green\"><svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"/></svg>SENT</span><span class=\"ds-stamp ds-stamp-red\">NEEDS TIME</span><span class=\"ds-stamp ds-stamp-flat\">DRAFT</span><span class=\"ds-stamp ds-stamp-flat ds-struck\">CANCELLED</span></div>",
      "css": ".ds-stamps{display:flex;flex-wrap:wrap;gap:12px;align-items:center;padding:8px;}.ds-stamp{display:inline-flex;align-items:center;gap:4px;white-space:nowrap;border-radius:4px;border:1.5px solid;background:#fff;padding:4px 8px;font-family:var(--font-heading);font-size:11px;font-weight:700;line-height:1;letter-spacing:0.1em;}.ds-stamp-navy{rotate:-3deg;border-color:var(--color-navy);color:var(--color-navy);}.ds-stamp-green{rotate:-3deg;border-color:var(--color-green);color:var(--color-green);}.ds-stamp-red{rotate:-3deg;border-color:var(--color-red);color:var(--color-red);}.ds-stamp-flat{border-color:var(--color-stamp);color:var(--color-muted);}.ds-struck{text-decoration:line-through;text-decoration-thickness:1.5px;}.ds-stamp-navy:hover,.ds-stamp-green:hover{animation:ds-land 200ms cubic-bezier(0.16,1,0.3,1);}@keyframes ds-land{from{scale:1.08;rotate:-6deg;}to{scale:1;rotate:-3deg;}}@media (prefers-reduced-motion: reduce){.ds-stamp{animation:none!important;}}"
    },
    {
      "name": "Colleague Rail",
      "kind": "nav",
      "refersTo": "rail-row",
      "description": "Cream-2 rail of colleagues with avatars, flag dots and counts; selected row fills navy.",
      "html": "<nav class=\"ds-rail\"><h2 class=\"ds-rail-h\">Colleagues</h2><button class=\"ds-rail-row\"><span class=\"ds-av\">AK</span><span class=\"ds-nm\">Avery Kim</span><span class=\"ds-dot ds-dot-amber\"></span><span class=\"ds-ct\">3</span></button><button class=\"ds-rail-row ds-rail-on\" aria-current=\"true\"><span class=\"ds-av\">RC</span><span class=\"ds-nm\">Riley Chen</span><span class=\"ds-dot ds-dot-amber-navy\"></span><span class=\"ds-ct\">2</span></button><button class=\"ds-rail-row\"><span class=\"ds-av\">SP</span><span class=\"ds-nm\">Sam Patel</span><span class=\"ds-ct\">2</span></button></nav>",
      "css": ".ds-rail{width:250px;background:var(--color-cream-2);padding:20px 14px;}.ds-rail-h{margin:0 10px 8px;font-family:var(--font-heading);font-size:12px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--color-muted);}.ds-rail-row{display:flex;width:100%;align-items:center;gap:10px;border:0;border-radius:8px;background:transparent;padding:8px 10px;margin-bottom:2px;text-align:left;font-family:var(--font-sans);font-size:14px;font-weight:600;color:var(--color-ink);cursor:pointer;transition:background-color 150ms ease-out;}.ds-rail-row:hover{background:rgb(227 222 176 / 0.45);}.ds-rail-row:focus-visible{outline:2px solid var(--color-navy);outline-offset:2px;}.ds-rail-on,.ds-rail-on:hover{background:var(--color-navy);color:#fff;}.ds-av{display:grid;place-items:center;width:28px;height:28px;flex-shrink:0;border-radius:9999px;background:var(--color-beige);color:var(--color-navy);font-family:var(--font-heading);font-size:11px;font-weight:700;}.ds-nm{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}.ds-dot{width:8px;height:8px;border-radius:9999px;flex-shrink:0;}.ds-dot-amber{background:var(--color-amber);}.ds-dot-amber-navy{background:var(--color-amber-on-navy);}.ds-ct{width:24px;text-align:right;font-family:var(--font-heading);font-variant-numeric:tabular-nums;color:var(--color-muted);}.ds-rail-on .ds-ct{color:var(--color-beige);}"
    },
    {
      "name": "Timetable",
      "kind": "card",
      "refersTo": "table-container",
      "description": "One white hairline card per day; fixed columns, Figtree times, stamps in the last column.",
      "html": "<section class=\"ds-tt\"><h2 class=\"ds-day\">Wednesday, December 2</h2><div class=\"ds-card\"><table><colgroup><col style=\"width:104px\"><col><col style=\"width:104px\"><col style=\"width:128px\"></colgroup><thead><tr><th>Time</th><th>Company</th><th>Room</th><th>Status</th></tr></thead><tbody><tr class=\"ds-sel\"><td><b class=\"ds-t\">9:30 AM</b><span class=\"ds-sub\">to 10:30 AM</span></td><td><b>Pixelmint Studios</b><span class=\"ds-tk\">PXMS</span><span class=\"ds-sub\">June Park, CFO · Group</span></td><td>Ballroom C</td><td><span class=\"ds-stamp\">VERIFIED</span></td></tr><tr><td><b class=\"ds-t\">9:45 AM</b><span class=\"ds-sub\">to 10:30 AM</span></td><td><b>Orbital Data Networks</b><span class=\"ds-tk\">ORDN</span><span class=\"ds-sub\">Sol Mendes, CFO · 1x1</span></td><td>Suite 2210</td><td><span class=\"ds-stamp ds-flat\">DRAFT</span></td></tr></tbody></table></div></section>",
      "css": ".ds-tt{background:var(--color-cream);padding:16px;font-family:var(--font-sans);color:var(--color-ink);}.ds-day{margin:0 0 8px;font-family:var(--font-heading);font-size:13px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:var(--color-blue);}.ds-card{overflow:hidden;border:1px solid var(--color-line);border-radius:8px;background:#fff;}.ds-card table{width:100%;table-layout:fixed;border-collapse:collapse;font-size:14px;}.ds-card th{background:var(--color-head);border-bottom:1px solid var(--color-line);padding:10px 12px;text-align:left;font-family:var(--font-heading);font-size:11px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:var(--color-muted);}.ds-card td{border-bottom:1px solid var(--color-rule);padding:11px 12px;vertical-align:middle;}.ds-card tr:last-child td{border-bottom:0;}.ds-card tbody tr{cursor:pointer;transition:background-color 150ms ease-out;}.ds-card tbody tr:hover{background:var(--color-cream);}.ds-card tbody tr.ds-sel{background:var(--color-select);}.ds-t{display:block;font-family:var(--font-heading);font-variant-numeric:tabular-nums;}.ds-sub{display:block;font-size:12px;font-weight:500;color:var(--color-muted);}.ds-tk{margin-left:6px;font-family:var(--font-heading);font-size:11px;font-weight:700;color:var(--color-blue);}.ds-stamp{display:inline-flex;rotate:-3deg;border:1.5px solid var(--color-navy);border-radius:4px;background:#fff;padding:4px 8px;font-family:var(--font-heading);font-size:11px;font-weight:700;line-height:1;letter-spacing:0.1em;color:var(--color-navy);}.ds-stamp.ds-flat{rotate:0deg;border-color:var(--color-stamp);color:var(--color-muted);}"
    },
    {
      "name": "Notes",
      "kind": "custom",
      "refersTo": "note-amber",
      "description": "Tinted inline notes: red blocks, amber checks, cream informs.",
      "html": "<div class=\"ds-notes\"><div class=\"ds-note ds-note-red\">No colleague matched. Add one before verifying.</div><div class=\"ds-note ds-note-amber\">Matched to Riley Chen by similar spelling. Check it.</div><div class=\"ds-note ds-note-info\">Shared with 1 colleague; edits update every calendar.</div></div>",
      "css": ".ds-notes{display:grid;gap:8px;width:340px;}.ds-note{border:1px solid;border-radius:6px;padding:10px 12px;font-family:var(--font-sans);font-size:13px;font-weight:600;}.ds-note-red{border-color:var(--color-red-line);background:var(--color-red-bg);color:var(--color-red);}.ds-note-amber{border-color:var(--color-amber-line);background:var(--color-amber-bg);color:var(--color-amber);}.ds-note-info{border-color:var(--color-line);background:var(--color-cream);color:var(--color-ink);}"
    }
  ],
  "narrative": {
    "northStar": "The Stamped Itinerary",
    "overview": "Meeting Calendar Sync wears the Woodline Partners house colours (taken from woodlinepartners.com) as a quiet internal desk: a navy bar across the top, a cream ground, a cream-2 rail, and white tables ruled in beige hairlines. It is a working surface for a coordinator who checks sixty meetings in one sitting, so density is high. Most text is 13 to 15px, rows are compact, and every number is set in tabular Figtree so the columns read as a timetable rather than prose.\n\nThe world borrows its character from the airline ticket wallet and the split-flap board. Columns sit at fixed widths and never move, rows rank by time, and state lives in small letter-spaced stamps that sit on white chips and tilt three degrees when a person has acted on them (VERIFIED, SENT). Untouched states (DRAFT) and cancelled ones lie flat, and cancelled meetings are struck through instead of vanishing. The one authored motion is the stamp landing; everything else changes colour in 150ms and stays put.\n\nDepth is flat. Surfaces are separated by tone (navy, cream, cream-2, white) and 1px warm hairlines; soft navy-tinted shadows appear only on layers that float above the layout. The app has no photography and no hero banners. It must never read as a marketing site.",
    "keyCharacteristics": [
      "Navy bar, cream ground, cream-2 rail, white tables with beige hairlines.",
      "Figtree for headings, numbers, labels and stamps; Manrope for running UI text; Libre Baskerville only in the WOODLINE wordmark.",
      "Tilted stamps for states a person earned; flat stamps for states nobody has acted on yet.",
      "Fixed-width columns that line up from day to day; nothing disappears, it gets struck.",
      "Flat at rest; shadows only on floating layers."
    ],
    "rules": [
      {
        "name": "The One Beige Action Rule",
        "body": "A beige fill marks the single forward action of its band: Verify all ready on the bar, Accept all on the revision strip. One per band; everything else is quiet or ghost.",
        "section": "colors"
      },
      {
        "name": "The Navy-Means-Here Rule",
        "body": "Where the user is shows in navy: the selected rail row is filled navy, the selected chip navy-2, the active nav link carries a beige underline, and the focus ring is a 2px navy outline (beige on navy).",
        "section": "colors"
      },
      {
        "name": "The On-Navy Twin Rule",
        "body": "On the navy bar, status colours switch to their twins (red-on-navy, amber-on-navy) and focus rings switch to beige. Base red, amber and navy outlines never sit on navy.",
        "section": "colors"
      },
      {
        "name": "The Figtree Figures Rule",
        "body": "Any number a coordinator compares (time, count, total, ticker) is Figtree bold with tabular figures, so columns of figures align.",
        "section": "typography"
      },
      {
        "name": "The Wordmark-Only Serif Rule",
        "body": "Libre Baskerville appears only in the WOODLINE wordmark (uppercase, 0.25em tracking). No other heading, label or number uses it.",
        "section": "typography"
      },
      {
        "name": "The Floating-Only Shadow Rule",
        "body": "If it sits in the layout, it has a hairline and no shadow. A shadow means the layer floats above something (popover, drawer, toast, bubble), or it is a physical object in the scene (the PDF page, the switch knob).",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do separate surfaces by tone and 1px warm hairlines (line, rule) rather than shadows.",
      "Do set every time, count, total and ticker in Figtree bold with tabular figures.",
      "Do tilt a stamp (-3deg) only for a state a person acted on, and keep DRAFT and CANCELLED flat.",
      "Do put every stamp on a white chip so green and red keep their contrast on the select tint.",
      "Do strike cancelled meetings through (1.5px) and leave them in place; nothing disappears.",
      "Do keep timetable columns at fixed widths so days line up, and let rows stack only below 616px of column width.",
      "Do use the on-navy twins (red-on-navy, amber-on-navy) and a beige focus ring on the navy bar.",
      "Do use inline SVG icons (lucide line icons, 2 to 3px stroke) for checks, warnings and actions.",
      "Do keep transitions to 150ms ease-out colour changes, and honour reduced motion (stamps and reveals stop, transitions collapse)."
    ],
    "donts": [
      "Don't use photos, hero banners or marketing-page composition; this is an internal Operate tool.",
      "Don't use Libre Baskerville outside the WOODLINE wordmark.",
      "Don't put more than one beige-filled button in a band.",
      "Don't add shadows to resting cards, tables, chips or buttons; and never use grey or black shadows.",
      "Don't animate beyond the stamp landing, the revision-strip reveal and the extraction progress sweep; loading skeletons hold still.",
      "Don't use typed glyphs (✓, →) for status or icons; the check in SENT is an SVG.",
      "Don't introduce new radii; use 4px (stamps, focus), 6px (controls), 8px (containers) or a full pill."
    ]
  }
}
